def pip_install(args, timeout=2400, quiet=True):
    cmd = [sys.executable, "-m", "pip", "install"]
    if quiet:
        cmd.append("-q")
    cmd += ["--no-cache-dir"] + args
    print("    → pip", " ".join(args))
    return subprocess.run(cmd, timeout=timeout).returncode == 0

